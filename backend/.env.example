APP_ENV=development
DATABASE_URL=sqlite:///./oasis_dev.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin access is disabled until all three values are configured.
# Generate a password hash from the backend folder with:
# python -c "from pwdlib import PasswordHash; print(PasswordHash.recommended().hash('REPLACE_WITH_A_LONG_UNIQUE_PASSWORD'))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=30
